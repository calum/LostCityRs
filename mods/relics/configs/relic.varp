[relic_owned]
scope=perm

[relic_seed]
scope=perm

[relic_xp_tier]
scope=perm

[relic_xp_factor]
scope=perm

[relic_tasks_done]
scope=perm

[relic_tasks_done2]
scope=perm

[relic_declined]
scope=perm

[relic_started]
scope=perm

// Retired (rerolls were removed 2026-10-11): kept declared so saves that hold a value for them still load. Unused.
[relic_rerolls_used]
scope=perm

// Retired with the rerolls, unused (see relic_rerolls_used).
[relic_offer_shown]
scope=perm

[relic_pending]
scope=perm

[relic_recall_a]
scope=perm
type=coord
protect=no

[relic_phoenix_until]
scope=perm
protect=no

[relic_hide_done]
scope=perm
protect=no

// Rune Wellspring: XP gained (tenths) not yet paid out as bundles. Written by the Player.addXp hook (Engine-TS).
[relic_wellspring_xp]
scope=perm
protect=no

// Green Thumb: raw XP gained (tenths) not yet paid out as herbs. Written by the Player.addXp hook (Engine-TS).
[relic_herb_xp]
scope=perm
protect=no

// Offers owed with a special rule (relic_task_done): a Quest Pass grant (10th task done) and offers that guarantee an XP Multiplier option (every other 5th).
[relic_quest_owed]
scope=perm

[relic_xp_owed]
scope=perm

// Play time: game ticks (0.6 s) spent logged in since this feature went live, counted by [softtimer,relic_playtime_timer]. Written from a timer, so protect=no.
[relic_playticks]
scope=perm
protect=no

// %relic_playticks at the moment the final challenge was completed (both final bosses down); 0 = not finished yet.
[relic_finish_ticks]
scope=perm
protect=no

// Bonus boss fight glow colour: 0 = none, otherwise 1 to 12 (index into enum relic_bonus_auras). Not saved.
[relic_bonus_colour]
scope=temp
protect=no
