// Invisible controllers of the bonus boss fight (mods/relics/scripts/relic_bonus.rs2), parked on a free tile outside the lair.
[relic_bonus_timer]
vislevel=hide
name=Bonus timer
model1=man_torso_basic
blockwalk=none

[relic_bonus_glow]
vislevel=hide
name=Bonus glow
model1=man_torso_basic
blockwalk=none
timer=2

// One marker per bonus boss killed (KBD or flying Kalphite Queen) while the fight runs; the fourth one starts the party.
[relic_bonus_kill]
vislevel=hide
name=Bonus kill
model1=man_torso_basic
blockwalk=none

// Waits 3 ticks after the last bonus boss died, then the congratulating crowd arrives (relic_party.rs2).
[relic_party_timer]
vislevel=hide
name=Party timer
model1=man_torso_basic
blockwalk=none
