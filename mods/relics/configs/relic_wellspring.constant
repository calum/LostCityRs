// Rune Wellspring (relic 21). Bundle price in XP tenths (the unit the engine stores): 1000 = 100 real XP, after the XP rate.
^relic_wellspring_xp_per_bundle = 1000
// Rune essence in one bundle.
^relic_wellspring_essence = 100
// Most bundles crafted by one use on an altar (tamed from 10000: 300k bundles took level 1 straight to 99). At 25, air runes at
// 30x XP give 25 * 100 * 5 * 30 = 375,000 XP a use, so level 99 (13M XP) is about 35 uses; the cap also keeps XP inside 32 bits.
^relic_wellspring_max_craft = 25
