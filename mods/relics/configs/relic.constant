// relic_tasks_done bit = task number - 1. Tier masks cover the task bits of each tier.
^relic_tier1_mask = 63
^relic_tier2_mask = 8128
^relic_tier3_mask = 8380416
^relic_tier4_mask = 25165824
^relic_task_count = 45
// tasks shown in the task menu: the highest number minus the retired task 37 (death rune, the death altar is not usable)
^relic_task_listed = 44
// engine base XP rate, node.xpRate in config/world.json (only used to show the rate in the relics menu)
^relic_base_xp = 10
// Fellowship (relic 31): reach in tiles and share of the owner's food healing. The XP share is in Engine-TS Player.ts (RELIC_FELLOWSHIP_RADIUS, RELIC_FELLOWSHIP_XP_PERCENT).
^relic_fellowship_radius = 5
^relic_fellowship_heal_percent = 50
^relic_fellowship_xp_percent = 50
