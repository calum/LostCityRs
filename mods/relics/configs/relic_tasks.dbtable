// 39 tasks (26-39: skilling tasks added after the two final bosses, 24 and 25; tasks 32 and up are stored in %relic_tasks_done2, bit = task - 32).
// Tasks 38 and 39 (cast High Level Alchemy, Camelot Teleport) are detected in ~relic_task_spell and have no row. Kill tasks: one row per npc type. Product tasks: one row per object.
// Tasks 7 (burn yew, firemaking.rs2) and 13 (pickpocket a paladin) are detected in their scripts and have no row. Tiers: 1-6, 7-13, 14-23, 24-25.
[relic_task_npc]
column=task,int,REQUIRED
column=npc,npc,INDEXED,REQUIRED
column=tier,int,REQUIRED

[relic_task_obj]
column=task,int,REQUIRED
column=obj,obj,INDEXED,REQUIRED
column=tier,int,REQUIRED
