// Offer engine. Relic ids: 1 = XP Multiplier (tiers, not a bit), 2..14, 16..31 = bit n of %relic_owned (15 Infinite Runes was retired and its bit is never used again).
// %relic_pending counts offers the player has earned but not yet answered (a closed dialog leaves it set; login re-offers).
// Everything here needs protected access: run it from a queue script (see relic_offer_q).

[proc,relic_name](int $id)(string)
switch_int ($id) {
    case 1 : return("XP Multiplier");
    case 2 : return("Quest Pass");
    case 3 : return("Stoneskin");
    case 4 : return("Quickstrike");
    case 5 : return("Glass Cannon");
    case 6 : return("Phoenix");
    case 7 : return("Vampire");
    case 8 : return("Executioner");
    case 9 : return("Bounty");
    case 10 : return("Eternal Vein");
    case 11 : return("Evergreen");
    case 12 : return("Double Yield");
    case 13 : return("Midas Loop");
    case 14 : return("Philosopher's Coin");
    case 16 : return("Everlasting Jewellery");
    case 17 : return("Last Recall");
    case 18 : return("Banker's Call");
    case 19 : return("Hoarder");
    case 22 : return("Archmage");
    case 23 : return("Endless Quiver");
    case 24 : return("Teleport Network");
    case 21 : return("Rune Wellspring");
    case 25 : return("Prospector's Pick");
    case 26 : return("Forge Echo");
    case 27 : return("Endless Shoal");
    case 28 : return("Fletcher's Echo");
    case 29 : return("Hunter's Haul");
    case 30 : return("Light Fingers");
    case 20 : return("Green Thumb");
    case 31 : return("Fellowship");
    case default : return("Unknown relic");
}

[proc,relic_desc](int $id)(string)
switch_int ($id) {
    case 1 : return("XP rate triples");
    case 2 : return("all quests complete");
    case 3 : return("half damage taken, +50% accuracy");
    case 4 : return("attack twice as fast, +50% accuracy");
    case 5 : return("deal double, take x1.5, +50% accuracy");
    case 6 : return("survive one lethal hit, +50% accuracy");
    case 7 : return("heal on kill, +50% accuracy");
    case 8 : return("finish weak monsters, +50% accuracy");
    case 9 : return("kills drop loot, +50% accuracy");
    case 10 : return("rocks stay, ore smelts to bank");
    case 11 : return("trees stay, logs to bank");
    case 12 : return("double ore, fish and XP");
    case 13 : return("high alch repeats");
    case 14 : return("alchemy pays double");
    case 16 : return("jewellery never runs out");
    case 17 : return("teleport back and forth");
    case 18 : return("bank from anywhere");
    case 19 : return("pick a declined relic");
    case 22 : return("double spell damage, repeat casts");
    case 23 : return("ammo never runs out, +50% ranged");
    case 24 : return("teleport to the main cities");
    case 21 : return("XP pays rune essence, talisman teleports");
    case 25 : return("mine, chop and fish every 2 ticks");
    case 26 : return("smelt and smith: 50% extra");
    case 27 : return("fish go to the bank, spots stay");
    case 28 : return("fletching: 50% extra");
    case 29 : return("hides: 3 tanned, to the bank, gems");
    case 30 : return("pickpockets never fail and repeat, stalls never empty");
    case 20 : return("boosts never drain, secondaries stay, XP grows herbs");
    case 31 : return("players within 5 tiles share half your XP and food healing");
    case default : return("");
}

// 1 for an id that is a relic today. 15 (Infinite Runes) was retired; a new relic id is hidden here until its work lands.
[proc,relic_exists](int $id)(int)
if ($id = 15) {
    return(0);
}
return(1);

[proc,relic_eligible](int $id)(int)
if ($id = 1) {
    if (%relic_xp_tier < 3) {
        return(1);
    }
    return(0);
}
if (testbit(%relic_owned, $id) = ^true) {
    return(0);
}
return(~relic_exists($id));

// $mode 0: every eligible relic. $mode 1: only eligible relics the player declined earlier (Hoarder).
// Quest Pass (2) is never drawn: it is granted only by the 10th task done (relic_task_done).
[proc,relic_in_pool](int $id, int $drawn, int $mode)(int)
if ($id = 2 | ~relic_eligible($id) = 0 | testbit($drawn, $id) = ^true) {
    return(0);
}
if ($mode = 1 & (testbit(%relic_declined, $id) = ^false | testbit(%relic_hoarder_skip, $id) = ^true)) {
    return(0);
}
return(1);

// Number of pool relics not in the $drawn bitmask.
[proc,relic_pool_size](int $drawn, int $mode)(int)
def_int $size = 0;
def_int $i = 1;
while ($i <= 31) {
    if (~relic_in_pool($i, $drawn, $mode) = 1) {
        $size = calc($size + 1);
    }
    $i = calc($i + 1);
}
return($size);

// Advance the seed (small Lehmer-style generator so every intermediate stays exact) and return the k-th
// eligible relic not in $drawn, or 0 if none is left.
[proc,relic_draw](int $drawn, int $mode)(int)
def_int $size = ~relic_pool_size($drawn, $mode);
if ($size = 0) {
    return(0);
}
%relic_seed = calc((%relic_seed * 75 + 74) % 65537);
def_int $k = calc(%relic_seed % $size);
def_int $i = 1;
while ($i <= 31) {
    if (~relic_in_pool($i, $drawn, $mode) = 1) {
        if ($k = 0) {
            return($i);
        }
        $k = calc($k - 1);
    }
    $i = calc($i + 1);
}
return(0);

[proc,relic_option](int $id)(string)
return("<~relic_name($id)>: <~relic_desc($id)>");

// The "attuned" effect when a relic is gained: kneel, enchant glow, chime. The chime is synth 912 (Content/synth/relic_attune.synth,
// a copy of enchant_diamond_amulet); the client can replace it with a recorded sound (docs/guide/relic-attune-sound.md).
[proc,relic_attune]
anim(human_pray, 0);
spotanim_pl(enchant_amulet_lvl3, 92, 0);
sound_synth(relic_attune, 1, 0);

[proc,relic_grant](int $id)
if ($id = 1) {
    %relic_xp_tier = calc(%relic_xp_tier + 1);
    ~relic_xp_recompute;
} else {
    %relic_owned = setbit(%relic_owned, $id);
}
%relic_declined = clearbit(%relic_declined, $id);
~relic_say("You gained the relic: <~relic_name($id)>.");
~relic_attune;
if ($id = 16) {
    ~relic_give_item(ring_of_dueling_8);
    ~relic_give_item(amulet_of_glory_4);
    ~relic_give_item(necklace_of_minigames_8);
} else if ($id = 17) {
    ~relic_give_item(relic_recall_stone);
} else if ($id = 18) {
    ~relic_give_item(relic_banker_stone);
} else if ($id = 24) {
    ~relic_give_item(relic_network_stone);
} else if ($id = 21) {
    ~relic_give_item(relic_wellspring_talisman);
} else if ($id = 20) {
    ~relic_herblore_starter;
} else if ($id = 2) {
    queue(relic_quest_pass, 0, 0);
} else if ($id = 19) {
    ~relic_hoarder_start;
}

// Tasks done, over both task varps (tasks 1-31 in %relic_tasks_done, 32 and up in %relic_tasks_done2).
[proc,relic_tasks_done_count]()(int)
def_int $n = 1;
def_int $count = 0;
while ($n <= ^relic_task_count) {
    if (~relic_task_is_done($n) = ^true) {
        $count = calc($count + 1);
    }
    $n = calc($n + 1);
}
return($count);

// Draw up to 3 relics (see relic_in_pool for $mode), ask, grant. Returns 1 if something was offered, 0 if the pool was empty.
// $force 1: the first option is the XP Multiplier whenever it is still eligible (every 5th task done).
// The seed advanced by the draws is stored only once the player answers: closing the dialog drops this script
// (Player.closeModal), so the seed stays where it was and the next login shows the same offer.
[proc,relic_offer_mode](int $mode)(int)
return(~relic_offer_run($mode, 0));

[proc,relic_offer_run](int $mode, int $force)(int)
def_int $seed_before = %relic_seed;
def_int $drawn = 0;
def_int $a = 0;
if ($force = 1 & ~relic_eligible(1) = 1) {
    $a = 1;
} else {
    $a = ~relic_draw($drawn, $mode);
}
if ($a = 0) {
    return(0);
}
$drawn = setbit($drawn, $a);
def_int $b = ~relic_draw($drawn, $mode);
if ($b ! 0) {
    $drawn = setbit($drawn, $b);
}
def_int $c = 0;
if ($b ! 0) {
    $c = ~relic_draw($drawn, $mode);
    if ($c ! 0) {
        $drawn = setbit($drawn, $c);
    }
}
def_int $seed_after = %relic_seed;
%relic_seed = $seed_before;
def_int $pick = 0;
if ($c ! 0) {
    $pick = ~p_choice3_header(~relic_option($a), $a, ~relic_option($b), $b, ~relic_option($c), $c, "Choose a relic");
} else if ($b ! 0) {
    $pick = ~p_choice2_header(~relic_option($a), $a, ~relic_option($b), $b, "Choose a relic");
} else {
    $pick = ~p_choice2_header(~relic_option($a), $a, "No thanks", 0, "Take this relic?");
}
%relic_seed = $seed_after;
// Everything offered and not picked can come back (and feeds Hoarder). Hoarder is granted first, so the widget it opens
// lists only relics declined in earlier offers; the relics of this offer are kept out of that list (%relic_hoarder_skip).
if ($pick = 19) {
    %relic_hoarder_skip = $drawn;
    ~relic_grant($pick);
}
def_int $i = 1;
while ($i <= 31) {
    if (testbit($drawn, $i) = ^true & $i ! $pick) {
        %relic_declined = setbit(%relic_declined, $i);
    }
    $i = calc($i + 1);
}
if ($pick ! 0 & $pick ! 19) {
    ~relic_grant($pick);
}
return(1);

// Answer every pending offer. An empty pool just clears the pending count.
[proc,relic_offer_pending]
// an open Hoarder pick comes first: the widget would be closed by the next dialogue (relic_hoarder_pick re-queues this)
while (%relic_pending > 0 & %relic_hoarder_owed = 0) {
    if (%relic_quest_owed > 0) {
        // the 10th task done: Quest Pass, straight away
        %relic_quest_owed = calc(%relic_quest_owed - 1);
        if (testbit(%relic_owned, 2) = ^false) {
            ~relic_grant(2);
        } else {
            def_int $s = ~relic_offer_run(0, 1);
        }
    } else if (%relic_xp_owed > 0) {
        // every 5th task done: the offer has an XP Multiplier option while one is left
        def_int $x = ~relic_offer_run(0, 1);
        %relic_xp_owed = calc(%relic_xp_owed - 1);
    } else {
        def_int $granted = ~relic_offer_mode(0);
    }
    %relic_pending = calc(%relic_pending - 1);
}

[queue,relic_offer_q]
~relic_offer_pending;

// Fireworks and the level-up jingle, as levelup.rs2 does (levelup.rs2:33,50).
[proc,relic_celebrate]
spotanim_pl(levelup_anim, 124, 0);
db_find(levelup:stat, attack);
def_dbrow $row = db_findnext;
if ($row ! null) {
    ~music_jingle(db_getfield($row, levelup:levelup_jingle, 0));
}

// Put an item in the inventory, or the bank if the inventory is full.
[proc,relic_give_item](namedobj $item)
if (inv_freespace(inv) > 0) {
    inv_add(inv, $item, 1);
} else {
    inv_add(bank, $item, 1);
    ~relic_say("Your inventory was full: <oc_name($item)> went to your bank.");
}

// The completion of a task: celebrate, then (tasks 24 and 25 are the finals, they owe no offer) owe an offer.
[queue,relic_task_done](int $task)
if (~relic_task_is_done($task) = 1) {
    return;
}
~relic_task_mark($task);
~relic_say("Relic task <tostring($task)> complete!");
// The client draws this as a fading toast at the top of the game view and does not add it to the chat (Client-TS toast).
mes("<~relic_task_name($task)>:relictask:");
~relic_celebrate;
if ($task = 24 | $task = 25) {
    if (and(%relic_tasks_done, ^relic_tier4_mask) = ^relic_tier4_mask) {
        ~relic_win;
    } else {
        ~relic_say("A final boss is down. Defeat the other one to win.");
    }
}
// Special offers by tasks done. The 10th task done, whichever task it is, is the Quest Pass (if not owned): granted directly,
// never earlier or later. Every 5th task done guarantees the XP Multiplier option. Final bosses owe no ordinary offer.
def_int $count = ~relic_tasks_done_count;
if ($count = 10 & testbit(%relic_owned, 2) = ^false) {
    %relic_quest_owed = calc(%relic_quest_owed + 1);
    %relic_pending = calc(%relic_pending + 1);
    queue(relic_offer_q, 3, 0);
    return;
}
if ($task = 24 | $task = 25) {
    return;
}
%relic_pending = calc(%relic_pending + 1);
if (calc($count % 5) = 0) {
    %relic_xp_owed = calc(%relic_xp_owed + 1);
}
// Not shown here: a kill task completes inside npc_death while the npc is still swinging, and a melee npc's
// swing at 0 hp runs if_close (npc_combat_melee.rs2:36), which drops a paused dialog. 3 ticks lets it finish.
queue(relic_offer_q, 3, 0);

// Quests completed when a run starts (Calum, 2026-10-12): Druidic Ritual, which unlocks Herblore. Same effects as [queue,druid_quest_complete]
// (Content quests/quest_druid/scripts/quest_druid.rs2:1-4) without Kaqemeex's talk or the scroll. XP is exactly 1x (%relic_quest_xp_off, Player.addXp).
[proc,relic_starter_quests]
if (%druidquest < ^druid_complete) {
    %druidquest = ^druid_complete;
    %relic_quest_xp_off = 1;
    stat_advance(herblore, 2500);
    %relic_quest_xp_off = 0;
    ~update_questpoints;
    ~update_questlist;
}

// First offer of a run: start the run, seed it, owe one offer.
[proc,relic_first_offer]
if (%relic_started = 1) {
    return;
}
%relic_started = 1;
~relic_starter_quests;
if (%relic_seed = 0) {
    %relic_seed = calc(random(65535) + 1);
}
%relic_pending = calc(%relic_pending + 1);
queue(relic_offer_q, 0, 0);

// login.rs2 hook: characters that already finished the tutorial start their run, others wait for the tutorial hook.
[proc,relic_on_login]
~relic_playtime_start;
if (%tutorial < ^tutorial_complete) {
    return;
}
~relic_ensure_keeper;
~relic_check_99;
// Relic 15 Infinite Runes was retired: take the bit away and owe one new offer in its place.
if (testbit(%relic_owned, 15) = ^true) {
    %relic_owned = clearbit(%relic_owned, 15);
    %relic_declined = clearbit(%relic_declined, 15);
    %relic_pending = calc(%relic_pending + 1);
    ~relic_say("The Infinite Runes relic has been retired. You have a new relic choice instead.");
}
if (%relic_started = 0) {
    ~relic_first_offer; // queues the offer itself
    return;
}
if (%relic_hoarder_owed > 0) {
    ~relic_hoarder_open;
}
if (%relic_pending > 0) {
    queue(relic_offer_q, 0, 0);
}

// 2 Quest Pass: reuse upstream's own "complete every quest" script (Content/scripts/_test/scripts/cheats/cheat_quest.rs2, label
// complete_all_quests). It asks which side to take in Shield of Arrav and Temple of Ikov, runs each quest's completion queue and
// grants the quests' reward items and XP.
// The quest reward XP is not multiplied by the XP Multiplier relic: %relic_quest_xp_off switches the factor off (Player.addXp) until
// relic_quest_pass_end sees that the last queued quest (viking_quest_complete) has run.
[queue,relic_quest_pass]
%relic_quest_xp_off = 1;
queue(relic_quest_pass_end, 0, 0);
@complete_all_quests;

[queue,relic_quest_pass_end]
if (getqueue(viking_quest_complete) > 0) {
    queue(relic_quest_pass_end, 1, 0);
    return;
}
%relic_quest_xp_off = 0;

// Both final bosses (tasks 24 King Black Dragon and 25 Kalphite Queen) are down: the run is won.
[proc,relic_win]
~relic_say("You have defeated both final bosses. You win the relic run!");
~relic_playtime_finish;
~mesbox("@gre@Congratulations!|You have defeated the King Black Dragon and the Kalphite Queen.|You have won the relic run.");
