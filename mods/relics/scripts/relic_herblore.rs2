// Relic 20 Green Thumb and tasks 43-45. Design: docs/design/relics-green-thumb.md. Hooks (docs/local-changes.md, grep "relic hook"):
//  - Content player/scripts/stat.rs2 [timer,stat_boost_restore]: boosts do not drain.
//  - Content skill_herblore/scripts/herblore.rs2 [proc,brew_potion]: the secondary is not used up.
//  - Engine Player.addXp -> relicGreenThumb: raw XP collects in %relic_herb_xp and queues [queue,relic_herbs].
//  - Content interface_bank/scripts/bank.rs2 [proc,bank_deposit_request]: banking herbs pays their cleaning XP (~relic_bank_herbs).

// 1. Stat boosts never drain (potions, kebabs, special attacks). Drained stats still recover to base ([timer,stat_regen]).
[proc,relic_boost_stays]()(int)
return(~relic_has(20));

// 2. brew_potion: 1 when the ingredient stays. Only a finished potion's secondary stays: the herb of an unfinished potion (a herb, or
// anything mixed into a vial of water) is still used up.
[proc,relic_keeps_secondary](namedobj $ingredient, namedobj $solvent)(int)
if (~relic_has(20) = 0 | $solvent = vial_water | oc_category($ingredient) = category_774) {
    return(0);
}
return(1);

// 3. XP -> herbs.
[queue,relic_herbs]
~relic_herbs_claim;

// Pay out one identified herb per ^relic_herb_xp_per_herb of raw XP, picked evenly from the herbs the player's Herblore level can identify
// (the identify check of [proc,attempt_identify_herb]). Herbs go to the bank, else the backpack; with no room the XP stays owed.
// Below the level of the first herb (guam, 3) the XP is dropped, so it does not pile up into a flood later.
[proc,relic_herbs_claim]
def_int $n = calc(%relic_herb_xp / ^relic_herb_xp_per_herb);
if ($n < 1) {
    return;
}
%relic_herb_xp = calc(%relic_herb_xp - $n * ^relic_herb_xp_per_herb);
def_int $level = stat(herblore);
def_int $eligible = 0;
while ($eligible < enum_getoutputcount(relic_herb_list) & oc_param(enum(int, namedobj, relic_herb_list, $eligible), identified_herb_level) <= $level) {
    $eligible = calc($eligible + 1);
}
if ($eligible = 0 | map_members = ^false) {
    return;
}
def_int $paid = 0;
def_namedobj $herb = null;
while ($paid < $n & $paid < ^relic_herb_max_claim) {
    $herb = enum(int, namedobj, relic_herb_list, random($eligible));
    if (inv_itemspace(bank, $herb, 1, inv_size(bank)) = ^true) {
        inv_add(bank, $herb, 1);
    } else if (inv_itemspace(inv, $herb, 1, inv_size(inv)) = ^true) {
        inv_add(inv, $herb, 1);
    } else {
        // no room anywhere: the unpaid herbs stay owed
        %relic_herb_xp = calc(%relic_herb_xp + ($n - $paid) * ^relic_herb_xp_per_herb);
        return;
    }
    $paid = calc($paid + 1);
}
if ($paid < $n) {
    // more than one claim's worth: the rest stays owed and is claimed next
    %relic_herb_xp = calc(%relic_herb_xp + ($n - $paid) * ^relic_herb_xp_per_herb);
    queue(relic_herbs, 0, 0);
}

// 3b. Banking a herb (grimy or clean) pays the Herblore XP of cleaning it, once per herb deposited, through stat_advance so the
// engine rate and the XP Multiplier apply. Called from [proc,bank_deposit_request] with the number actually moved. Herbs the relic itself puts
// in the bank (~relic_herbs_claim) and the death-relic transfers do not pass through here, so they pay nothing.
[proc,relic_bank_herbs](obj $obj, int $n)
if (~relic_has(20) = 0 | $n < 1) {
    return;
}
def_int $xp = ~relic_herb_clean_xp(oc_uncert($obj));
if ($xp < 1) {
    return;
}
// the cap keeps xp * n inside 32 bits (largest cleaning XP is 15 XP = 150 tenths)
if ($n > ^relic_bank_herb_max) {
    $n = ^relic_bank_herb_max;
}
stat_advance(herblore, multiply($xp, $n));

// Cleaning XP (in the unit of stat_advance) of one herb: identified_herb_exp of the clean herb, which a grimy herb shares.
[proc,relic_herb_clean_xp](obj $obj)(int)
switch_obj($obj) {
    case unidentified_guam : return(oc_param(guam_leaf, identified_herb_exp));
    case unidentified_marentill : return(oc_param(marentill, identified_herb_exp));
    case unidentified_tarromin : return(oc_param(tarromin, identified_herb_exp));
    case unidentified_harralander : return(oc_param(harralander, identified_herb_exp));
    case unidentified_ranarr : return(oc_param(ranarr_weed, identified_herb_exp));
    case unidentified_irit : return(oc_param(irit_leaf, identified_herb_exp));
    case unidentified_avantoe : return(oc_param(avantoe, identified_herb_exp));
    case unidentified_kwuarm : return(oc_param(kwuarm, identified_herb_exp));
    case unidentified_cadantine : return(oc_param(cadantine, identified_herb_exp));
    case unidentified_lantadyme : return(oc_param(lantadyme, identified_herb_exp));
    case unidentified_dwarf_weed : return(oc_param(dwarf_weed, identified_herb_exp));
    case unidentified_torstol : return(oc_param(torstol, identified_herb_exp));
    case unidentified_toadflax : return(oc_param(toadflax, identified_herb_exp));
    case unidentified_snapdragon : return(oc_param(snapdragon, identified_herb_exp));
    case unidentified_snake_weed : return(oc_param(snake_weed, identified_herb_exp));
    case unidentified_ardrigal : return(oc_param(ardrigal, identified_herb_exp));
    case unidentified_sito_foil : return(oc_param(sito_foil, identified_herb_exp));
    case unidentified_volencia_moss : return(oc_param(volencia_moss, identified_herb_exp));
    case unidentified_rogues_purse : return(oc_param(rogues_purse, identified_herb_exp));
}
// A clean herb carries the XP itself (the param is 0 on everything else, identify.param).
return(oc_param($obj, identified_herb_exp));

// 4. On taking the relic: one of every potion secondary, in the bank (the backpack if the bank is full). With boosts and secondaries
// that stay, this is all the player needs to find of them.
[proc,relic_herblore_starter]
~relic_stash(eye_of_newt);
~relic_stash(red_spiders_eggs);
~relic_stash(limpwurt_root);
~relic_stash(snape_grass);
~relic_stash(white_berries);
~relic_stash(unicorn_horn_dust);
~relic_stash(dragon_scale_dust);
~relic_stash(wine_of_zamorak);
~relic_stash(jangerberries);
~relic_stash(toads_legs);
~relic_stash(chocolate_dust);
~relic_stash(mortmyremushroom);
~relic_stash(cactus_potato);
~relic_say("One of every potion secondary was put in your bank.");

[proc,relic_stash](namedobj $item)
if (inv_itemspace(bank, $item, 1, inv_size(bank)) = ^true) {
    inv_add(bank, $item, 1);
} else {
    ~relic_give_item($item);
}
