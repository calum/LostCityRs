// One proc per relic effect. Ids as in relic_offer.rs2. Content hooks call these (docs/local-changes.md).

[proc,relic_has](int $id)(int)
return(testbit(%relic_owned, $id));

// damage.rs2 hook. 3 Stoneskin: half damage. 5 Glass Cannon: x1.5 taken. 6 Phoenix: a lethal hit leaves 1 HP, once per 5 minutes.
[proc,relic_damage_taken](int $amount)(int)
if ($amount <= 0) {
    return($amount);
}
if (~relic_has(3) = 1) {
    $amount = calc(($amount + 1) / 2);
}
if (~relic_has(5) = 1) {
    $amount = calc(($amount * 3 + 1) / 2);
}
if (~relic_has(6) = 1 & $amount >= stat(hitpoints) & map_clock >= %relic_phoenix_until) {
    %relic_phoenix_until = calc(map_clock + 500);
    $amount = calc(stat(hitpoints) - 1);
    anim(human_death, 0); // so the player sees it trigger
    say("I rise from the ashes!"); // overhead text, seen by every player nearby
    // human_death's frames before its endless hold last 47 client ticks (delay column of the seq, read in the harness); the fire flares as the fall ends and the player is back on their feet
    spotanim_pl(fireblast_impact, 92, 47);
    mes("Your Phoenix relic saves you from a lethal hit!");
}
return($amount);

// npc_combat.rs2 hook (npc_max_dealt). 5 Glass Cannon: double damage dealt, plus a 25% chance of an extra hitsplat (see
// relic_glass_extra). Called once per landed player attack on an npc, before the attack rolls its own damage.
[proc,relic_dealt](int $maxhit)(int)
~relic_execute;
if (~relic_has(5) = 1) {
    $maxhit = calc($maxhit * 2);
    if ($maxhit > 0) {
        ~relic_glass_extra($maxhit, 25);
    }
    return($maxhit);
}
return($maxhit);

// 5 Glass Cannon extra hitsplats. Each success (pct% chance) rolls randominc($maxhit) like the normal hit, queues it on the
// active npc, credits combat xp and hero points (capped by the hitpoints still unclaimed), then rolls again, so a chain
// of extra hitsplats is possible. The chain is capped at ^relic_glass_extra_max hitsplats. Extras land one tick apart so
// each one shows (an npc shows two hitsplats per tick); projectile attacks (ranged and magic) start 2 ticks later so the
// extras do not land before the projectile.
[proc,relic_glass_extra](int $maxhit, int $pct)
def_int $n = 0;
def_int $hp = npc_stat(hitpoints);
def_int $base = 0;
def_int $dmg = 0;
def_int $credit = 0;
if (%damagetype ! ^melee_style) {
    $base = 2;
}
while ($n < ^relic_glass_extra_max & random(100) < $pct) {
    $n = calc($n + 1);
    $dmg = randominc($maxhit);
    $credit = min($dmg, $hp);
    if ($credit > 0) {
        npc_heropoints($credit);
        ~give_combat_experience(%damagestyle, $credit, %npc_combat_xp_multiplier);
        $hp = calc($hp - $credit);
    }
    npc_queue(2, $dmg, calc($base + $n));
}

// player_combat.rs2 hook (player_attack_roll_specific, every PvM/PvP/special attack roll). Each combat relic (3 to 9) owned
// adds +50% to the player's attack roll for all styles. 23 Endless Quiver adds another +50% for ranged attacks only
// (^ranged_style = 3). Additive: n bonuses give x(1 + 0.5n).
[proc,relic_accuracy](int $roll, int $damagetype)(int)
def_int $pct = 100;
def_int $id = 3;
while ($id <= 9) {
    if (~relic_has($id) = 1) {
        $pct = calc($pct + 50);
    }
    $id = calc($id + 1);
}
if ($damagetype = ^ranged_style & ~relic_has(23) = 1) {
    $pct = calc($pct + 50);
}
return(scale($pct, 100, $roll));

// 22 Archmage. magic_spell_maxhit (pvp_magic.rs2) hook: spell max hit x2. A null max hit (-1, spells that do no damage) stays.
[proc,relic_spell_maxhit](int $maxhit)(int)
if (~relic_has(22) = 1 & $maxhit > 0) {
    return(calc($maxhit * 2));
}
return($maxhit);

// 22 Archmage. pvm_spell_cast (player_magic.rs2) hook: the cast delay is halved (rounded up); relic_delay (4 Quickstrike) applies after.
[proc,relic_cast_delay](int $ticks)(int)
if (~relic_has(22) = 1) {
    return(calc(($ticks + 1) / 2));
}
return($ticks);

// 22 Archmage. pvm_spell_cast hook: after a cast the player keeps casting the same spell at the same target (like autocast does),
// for spells flagged continue_by_autocast (damage strikes/bolts/blasts/waves, crumble undead; not freezes or stat drains). Walking
// or clicking something else clears the interaction, which stops it; running out of runes stops it in check_spell_requirements.
[proc,relic_keep_casting](dbrow $spell_data)(boolean)
if (~relic_has(22) = 1 & db_getfield($spell_data, magic_spell_table:continue_by_autocast, 0) = true) {
    return(true);
}
return(false);

// 22 Archmage. delete_spell_runes (magic.rs2) hook: 50% of casts (any spell) use no runes. The rune check before the cast still
// needs the runes in the backpack.
[proc,relic_free_cast]()(boolean)
if (~relic_has(22) = 1 & random(2) = 0) {
    return(true);
}
return(false);

// 23 Endless Quiver. player_ranged_attack (player_ranged.rs2) hook: ranged max hit x1.5.
[proc,relic_ranged_maxhit](int $maxhit)(int)
if (~relic_has(23) = 1) {
    return(scale(150, 100, $maxhit));
}
return($maxhit);

// 23 Endless Quiver. ranged_dropammo_npc (player_ranged.rs2) hook: the arrow, bolt or thrown weapon is neither used up nor dropped.
[proc,relic_keep_ammo]()(boolean)
if (~relic_has(23) = 1) {
    return(true);
}
return(false);

// alchemy.rs2 hooks. 14 Philosopher's Coin: alchemy pays double.
[proc,relic_alch_profit](int $profit)(int)
if (~relic_has(14) = 1) {
    return(calc($profit * 2));
}
return($profit);

// magic.rs2 hook (staff_runes): every rune count passes through here. Relic 15 Infinite Runes was retired, so it returns the count
// unchanged; the hook stays so a magic relic can change rune use again.
[proc,relic_rune_count](int $count)(int)
return($count);

// jewellery hooks. 16 Everlasting Jewellery: skip the charge swap (item moving to its next, lower-charge stage).
[proc,relic_keep_charge]()(int)
return(~relic_has(16));

// teleport.rs2 hook (end of pre_tele_checks). 17 Last Recall: remember where the teleport started.
[proc,relic_record_origin](coord $origin)
if (~relic_has(17) = 1) {
    %relic_recall_a = $origin;
}

[opheld1,relic_recall_stone]
def_coord $dest = %relic_recall_a;
if ($dest = null) {
    mes("You have not teleported anywhere yet.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
~player_teleport_normal($dest);

[opheld1,relic_banker_stone]
@openbank;

// 24 Teleport Network: the stone opens a list of cities, a click teleports the player there.
[opheld1,relic_network_stone]
if_openmain(relic_teleportmenu);

[proc,relic_network_go](coord $dest)
if (~pre_tele_checks(coord) = false) {
    return;
}
~player_teleport_normal($dest);

[if_button,relic_teleportmenu:lumbridge]
~relic_network_go(0_50_50_21_18);

[if_button,relic_teleportmenu:varrock]
~relic_network_go(0_50_53_13_32);

[if_button,relic_teleportmenu:falador]
~relic_network_go(0_46_52_21_50);

[if_button,relic_teleportmenu:edgeville]
~relic_network_go(0_48_54_15_40);

[if_button,relic_teleportmenu:draynor]
~relic_network_go(0_48_50_33_51);

[if_button,relic_teleportmenu:alkharid]
~relic_network_go(0_51_49_29_27);

[if_button,relic_teleportmenu:camelot]
~relic_network_go(0_43_54_5_22);

[if_button,relic_teleportmenu:ardougne]
~relic_network_go(0_41_51_37_37);

[if_button,relic_teleportmenu:karamja]
~relic_network_go(0_45_49_38_40);

// 7 Vampire, called from give_combat_experience (every player-vs-npc hit, with the damage actually dealt): heals ceil(10%) of
// it (so any hit of 1+ heals at least 1, a 0 hit heals nothing) as hitpoints and as prayer points, capped at the base levels by stat_heal.
[proc,relic_vampire](int $damage)
if (~relic_has(7) = 1 & $damage > 0) {
    def_int $heal = calc(($damage + 9) / 10);
    stat_heal(hitpoints, $heal, 0);
    stat_heal(prayer, $heal, 0);
}

// Called from relic_on_kill (npc_death hook) with the killer active. 9 Bounty drops coins (5 x (5 + 3 x base hitpoints)) and food by npc toughness.
[proc,relic_kill_effects]
if (~relic_has(9) = 1) {
    def_int $hp = npc_basestat(hitpoints);
    obj_add(npc_coord, coins, calc((5 + $hp * 3) * 5), ^lootdrop_duration);
    if ($hp >= 100) {
        obj_add(npc_coord, shark, 1, ^lootdrop_duration);
    } else if ($hp >= 50) {
        obj_add(npc_coord, swordfish, 1, ^lootdrop_duration);
    } else if ($hp >= 20) {
        obj_add(npc_coord, trout, 1, ^lootdrop_duration);
    } else {
        obj_add(npc_coord, bread, 1, ^lootdrop_duration);
    }
}

// attack-delay hooks (player_melee, player_ranged, player_special_attack, player_magic). 4 Quickstrike: half the delay, at least 1 tick.
[proc,relic_delay](int $ticks)(int)
if (~relic_has(4) = 1) {
    return(max(1, calc(($ticks + 1) / 2)));
}
return($ticks);

// player_melee.rs2 hook (the two normal melee swing sites). 4 Quickstrike for melee rounds the halved delay DOWN (5 -> 2, 3 -> 1, 4 -> 2), at least 1 tick.
// Ranged, magic and special attacks still use ~relic_delay (rounded up).
[proc,relic_delay_melee](int $ticks)(int)
if (~relic_has(4) = 1) {
    return(max(1, calc($ticks / 2)));
}
return($ticks);

// alchemy.rs2 hook (end of the high alchemy label). 13 Midas Loop: cast again while the player still has the item.
[proc,relic_midas](obj $item)(int)
if (~relic_has(13) = 1 & inv_total(inv, $item) > 0) {
    return(^true);
}
return(^false);

// 8 Executioner, called from relic_dealt (a landed player hit on the active npc). The npc damage queue has no player, so the
// decision is made here: if the npc is below 25% of its base hitpoints, queue its remaining hitpoints as damage and credit the
// player (hero points and combat xp) as if the hit had dealt them.
[proc,relic_execute]
if (~relic_has(8) = 0) {
    return;
}
def_int $hp = npc_stat(hitpoints);
if ($hp > 0 & calc($hp * 4) < npc_basestat(hitpoints)) {
    npc_heropoints($hp);
    ~give_combat_experience(%damagestyle, $hp, %npc_combat_xp_multiplier);
    npc_queue(2, $hp, 0);
}

// Repeats the cast from a weak queue: walking or clicking anything else clears the queue, which is how the player stops the loop
// (a p_delay loop cannot be interrupted: observed, docs/design/relics-m7-medium-relics.md).
[queue,relic_midas](obj $item)
@magic_spell_high_alch(^highlvl_alchemy, $item);
