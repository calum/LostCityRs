// Congratulating bot players (docs/design/relics-party-bots.md). When the four bonus bosses of the final fight are dead
// (relic_bonus.rs2), a crowd of cosmetic npcs with famous names appears around the players who are still in the lair. Each bot picks
// one of those players at random, follows them, shouts old school congratulations and leaves after a while. They are npcs (no
// options), so nobody can trade, attack or talk to them. Names, outfits and chat lines are generated by scripts/gen-relic-party.mjs
// into relic_party.npc / .enum / .constant.

[proc,relic_party_start](coord $centre, int $radius, boolean $lair_only, int $bots)
def_int $count = 0;
huntall($centre, $radius, 0);
while (huntnext = true) {
    if ($lair_only = false | ~relic_bonus_in_lair(coord) = true) {
        $count = calc($count + 1);
    }
}
if ($count = 0) {
    return;
}
// consecutive names from a random start, so a crowd has no repeats (up to ^relic_party_names bots)
def_int $start = random(^relic_party_names);
def_int $i = 0;
while ($i < $bots) {
    def_int $pick = random($count);
    def_int $seen = 0;
    def_int $name = calc(($start + $i) % ^relic_party_names + 1);
    huntall($centre, $radius, 0);
    while (huntnext = true) {
        if ($lair_only = false | ~relic_bonus_in_lair(coord) = true) {
            if ($seen = $pick) {
                ~relic_party_spawn($name);
            }
            $seen = calc($seen + 1);
        }
    }
    $i = calc($i + 1);
}

// With the player to follow active.
[proc,relic_party_spawn](int $name)
npc_add(map_findsquare(coord, 1, 3, ^map_findsquare_lineofwalk), enum(int, npc, relic_party_names, $name), 250);
spotanim_map(smokepuff, npc_coord, 124, 0);
%relic_party_target = uid;
npc_setmode(playerfollow);
~relic_party_say;

[proc,relic_party_say]
npc_say(enum(int, string, relic_party_msgs, calc(random(^relic_party_msgs) + 1)));

// Every 6 ticks a bot follows its player again (a crowd jostles, and a bot that gets stuck gives up following) and speaks up one time in two.
[ai_timer,_relic_party]
if (finduid(%relic_party_target) = true) {
    npc_setmode(playerfollow);
}
if (random(2) = 0) {
    ~relic_party_say;
}

[ai_despawn,_relic_party]
spotanim_map(smokepuff, npc_coord, 124, 0);

// The last bonus boss died 3 ticks ago: the crowd arrives around whoever is still in the lair.
[ai_despawn,relic_party_timer]
~relic_party_start(0_42_153_32_20, 16, true, 40);

// ::~relic_party spawns the crowd around the caller (and anyone within 16 tiles), wherever they are.
[debugproc,relic_party]
if (p_finduid(uid) = false) {
    return;
}
~relic_party_start(coord, 16, false, 40);
