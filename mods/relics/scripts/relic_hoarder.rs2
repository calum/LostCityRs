// Relic 19 Hoarder: one extra pick from every relic declined in an earlier offer, in a scrolling widget
// (interface mods/relics/interfaces/relic_hoardermenu.if, rows enum relic_hoarder_rows). Docs: docs/design/relics-hoarder.md.
// The relics of the offer that granted Hoarder are kept out of the list: %relic_hoarder_skip holds that offer's relics until the pick is made.

// The $n-th (1-based) relic id that is declined and still eligible, in relic id order, or 0.
[proc,relic_hoarder_nth](int $n)(int)
def_int $i = 1;
while ($i <= 31) {
    if (~relic_in_pool($i, 0, 1) = 1) {
        $n = calc($n - 1);
        if ($n = 0) {
            return($i);
        }
    }
    $i = calc($i + 1);
}
return(0);

// Mode 1 of relic_in_pool (relic_offer.rs2) is the list: eligible, declined, and not in %relic_hoarder_skip.
// Hoarder was just granted: owe the pick and open the list, unless nothing is declined yet.
[proc,relic_hoarder_start]
if (~relic_pool_size(0, 1) = 0) {
    %relic_hoarder_skip = 0;
    return;
}
%relic_hoarder_owed = calc(%relic_hoarder_owed + 1);
~relic_hoarder_open;

[proc,relic_hoarder_open]
def_int $total = ~relic_pool_size(0, 1);
if ($total = 0) {
    %relic_hoarder_owed = 0;
    %relic_hoarder_skip = 0;
    ~relic_say("Hoarder: you have no declined relics left to take.");
    return;
}
def_int $row = 0;
def_int $id = 0;
def_component $com = null;
while ($row < 30) {
    $com = enum(int, component, relic_hoarder_rows, $row);
    $id = ~relic_hoarder_nth(calc($row + 1));
    if ($id = 0) {
        if_settext($com, "");
    } else {
        if_settext($com, "@yel@<~relic_name($id)> @whi@- <~relic_desc($id)>");
    }
    $row = calc($row + 1);
}
if_settext(relic_hoardermenu:count, "<tostring($total)> declined relics to choose from. Click one to take it.");
if_openmain(relic_hoardermenu);
if_setscrollpos(relic_hoardermenu:list, 0);

[proc,relic_hoarder_pick](int $n)
if (%relic_hoarder_owed = 0) {
    return;
}
def_int $id = ~relic_hoarder_nth($n);
if ($id = 0) {
    return;
}
%relic_hoarder_owed = calc(%relic_hoarder_owed - 1);
%relic_hoarder_skip = 0;
if_close;
~relic_grant($id);
if (%relic_pending > 0) {
    queue(relic_offer_q, 1, 0);
}

[if_button,relic_hoardermenu:row_1]
~relic_hoarder_pick(1);

[if_button,relic_hoardermenu:row_2]
~relic_hoarder_pick(2);

