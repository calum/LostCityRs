// M1 probes. Run with ::~relic_demo <bit>, ::~relic_show, ::~relic_choice, ::~relic_queue_choice
[debugproc,relic_demo](int $bit)
if (p_finduid(uid) = false) {
    return;
}
%relic_owned = setbit(%relic_owned, $bit);
%relic_test = add(%relic_test, 1);
~relic_say("demo owned=<tostring(%relic_owned)> test=<tostring(%relic_test)>");

[debugproc,relic_show]
if (p_finduid(uid) = false) {
    return;
}
~relic_say("show owned=<tostring(%relic_owned)> test=<tostring(%relic_test)> seed=<tostring(%relic_seed)>");

[debugproc,relic_choice]
if (p_finduid(uid) = false) {
    return;
}
~relic_choice_run;

[proc,relic_choice_run]
def_int $pick = ~p_choice3_header("Relic A", 1, "Relic B", 2, "Relic C", 3, "Choose a relic");
%relic_test = $pick;
~relic_say("picked <tostring($pick)>");

[debugproc,relic_queue_choice]
if (p_finduid(uid) = false) {
    return;
}
queue(relic_choice_q, 0, 0);

[queue,relic_choice_q]
~relic_say("queue started");
~relic_choice_run;

// ::~relic_setxp <tier 0..3> sets the tier and recomputes the factor.
[debugproc,relic_setxp](int $tier)
if (p_finduid(uid) = false) {
    return;
}
%relic_xp_tier = $tier;
~relic_xp_recompute;
~relic_say("xp tier <tostring(%relic_xp_tier)> factor <tostring(%relic_xp_factor)>");

// ::~relic_xptest advances 1000 xp in fletching and reports the resulting base level.
[debugproc,relic_xptest]
if (p_finduid(uid) = false) {
    return;
}
stat_advance(fletching, 1000);
~relic_say("fletching base level <tostring(stat_base(fletching))> after +1000 at factor <tostring(%relic_xp_factor)>");

// ::~relic_energy prints run energy (0..10000) and whether the player is set to run.
[debugproc,relic_energy]
if (p_finduid(uid) = false) {
    return;
}
~relic_say("runenergy <tostring(runenergy)>");

// ::~relic_task <n> completes task n as if it had been done (respects tiers).
[debugproc,relic_task](int $task)
if (p_finduid(uid) = false) {
    return;
}
~relic_say("manual task <tostring($task)> tier <tostring(~relic_current_tier(0))> done mask <tostring(%relic_tasks_done)>");
~relic_task_try($task, 1);

[debugproc,relic_tasks_reset]
if (p_finduid(uid) = false) {
    return;
}
%relic_tasks_done = 0;
~relic_say("tasks reset");

// ::~relic_spawn <npc> spawns a stationary npc one tile east of you (fight it to test kill tasks).
[debugproc,relic_spawn](npc $npc)
if (p_finduid(uid) = false) {
    return;
}
npc_add(movecoord(coord, 1, 0, 0), $npc, 500);
npc_setmode(none);

// ::~relic_kill <npc> spawns the npc east of you, credits you with its damage and runs its real death script (ai_queue3).
[debugproc,relic_kill](npc $npc)
if (p_finduid(uid) = false) {
    return;
}
npc_add(movecoord(coord, 1, 0, 0), $npc, 500);
npc_heropoints(10);
npc_setmode(none);
npc_queue(3, 0, 0);

// M4 debug: ::~relic_offer (owe and show an offer), ::~relic_seed <n>, ::~relic_grant <id>, ::~relic_reset (clear all relic state).
[debugproc,relic_offer]
if (p_finduid(uid) = false) {
    return;
}
%relic_pending = calc(%relic_pending + 1);
queue(relic_offer_q, 0, 0);

[debugproc,relic_seed](int $seed)
if (p_finduid(uid) = false) {
    return;
}
%relic_seed = $seed;
~relic_say("seed <tostring($seed)>");

[debugproc,relic_grant](int $id)
if (p_finduid(uid) = false) {
    return;
}
~relic_grant($id);

[debugproc,relic_reset]
if (p_finduid(uid) = false) {
    return;
}
%relic_owned = 0;
%relic_declined = 0;
%relic_tasks_done = 0;
%relic_xp_tier = 0;
%relic_seed = 0;
%relic_started = 0;
%relic_pending = 0;
~relic_xp_recompute;
~relic_say("relic state cleared");

// M5 debug: ::~relic_hp <n> sets current hitpoints, ::~relic_hit <n> takes n damage through damage_self.
[debugproc,relic_hit](int $n)
if (p_finduid(uid) = false) {
    return;
}
~damage_self($n);
~relic_say("hit <tostring($n)> hp now <tostring(stat(hitpoints))>");

// ::~relic_cast casts Varrock Teleport as if the spell button was clicked (tests rune and teleport hooks).
[debugproc,relic_cast]
if (p_finduid(uid) = false) {
    return;
}
@magic_teleport(^varrock_teleport);

// ::~relic_where prints how many relic items are in inv, worn and bank.
[debugproc,relic_where]
if (p_finduid(uid) = false) {
    return;
}
~relic_say("stone inv/bank: <tostring(inv_total(inv, relic_recall_stone))>/<tostring(inv_total(bank, relic_recall_stone))> banker inv/bank: <tostring(inv_total(inv, relic_banker_stone))>/<tostring(inv_total(bank, relic_banker_stone))>");
~relic_say("ring inv/worn/bank: <tostring(inv_total(inv, ring_of_dueling_8))>/<tostring(inv_total(worn, ring_of_dueling_8))>/<tostring(inv_total(bank, ring_of_dueling_8))> hp <tostring(stat(hitpoints))>");

// ::~relic_lose deletes every relic item the player has, anywhere.
[debugproc,relic_lose]
if (p_finduid(uid) = false) {
    return;
}
inv_del(inv, relic_recall_stone, 100);
inv_del(inv, relic_banker_stone, 100);
inv_del(bank, relic_recall_stone, 100);
inv_del(bank, relic_banker_stone, 100);
inv_del(bank, ring_of_dueling_8, 100);
inv_del(bank, amulet_of_glory_4, 100);
inv_del(bank, necklace_of_minigames_8, 100);
~relic_say("relic items deleted");

// ::~relic_talk walks to and talks to the nearest Relic Keeper.
[debugproc,relic_talk]
if (p_finduid(uid) = false) {
    return;
}
if (npc_find(coord, relic_keeper, 20, 0) = true) {
    p_opnpc(1);
}

// ::~relic_keepers counts relic keepers within 60 tiles.
[debugproc,relic_keepers]
if (p_finduid(uid) = false) {
    return;
}
def_int $n = 0;
npc_findall(0_50_50_21_18, relic_keeper, 60, 0);
while (npc_findnext = true) {
    $n = calc($n + 1);
}
~relic_say("keepers in 60 tiles: <tostring($n)>");

// ::~relic_give <obj> <n> adds items to the inventory.
[debugproc,relic_give](namedobj $o, int $n)
if (p_finduid(uid) = false) {
    return;
}
inv_add(inv, $o, $n);

// ::~relic_gather <obj> <relic> runs the gather hook as if the player had just produced the item.
[debugproc,relic_gather](namedobj $o, int $r)
if (p_finduid(uid) = false) {
    return;
}
~relic_gathered($o, $r);

// ::~relic_chop adds a tree next to the player and starts chopping it.
[debugproc,relic_chop]
if (p_finduid(uid) = false) {
    return;
}
def_coord $c = movecoord(coord, 1, 0, 0);
loc_add($c, tree, 0, centrepiece_straight, 500);
if (loc_find($c, tree) = true) {
    p_oploc(1);
}

// ::~relic_inv prints inventory and bank counts of an item.
[debugproc,relic_count](namedobj $o)
if (p_finduid(uid) = false) {
    return;
}
~relic_say("<oc_name($o)> inv/bank: <tostring(inv_total(inv, $o))>/<tostring(inv_total(bank, $o))>");

// ::~relic_wound <npc> spawns the npc east of you with 2 hitpoints left and attacks it.
[debugproc,relic_wound](npc $npc)
if (p_finduid(uid) = false) {
    return;
}
npc_add(movecoord(coord, 1, 0, 0), $npc, 500);
npc_damage(^hitmark_damage, calc(npc_basestat(hitpoints) - 2));
p_opnpc(2);

// ::~relic_alch <obj> casts high alchemy on the item as if the spell was used on it.
[debugproc,relic_alch](obj $item)
if (p_finduid(uid) = false) {
    return;
}
@magic_spell_high_alch(^highlvl_alchemy, $item);

// ::~relic_delay_test prints relic_delay for 1, 4, 5 ticks with the current relics.
[debugproc,relic_delay_test]
if (p_finduid(uid) = false) {
    return;
}
~relic_say("quickstrike=<tostring(~relic_has(4))> delay 1/4/5 -> <tostring(~relic_delay(1))>/<tostring(~relic_delay(4))>/<tostring(~relic_delay(5))>");

// ::~relic_swing <npc> spawns an npc east of you and attacks it; prints its hitpoints after.
[debugproc,relic_swing](npc $npc)
if (p_finduid(uid) = false) {
    return;
}
npc_add(movecoord(coord, 1, 0, 0), $npc, 500);
p_opnpc(2);

// ::~relic_qp prints quest points.
[debugproc,relic_qp]
if (p_finduid(uid) = false) {
    return;
}
~relic_say("quest points: <tostring(%qp)>");

// ::~relic_alltasks marks tasks 1 to 23 as done (so the two final bosses count).
[debugproc,relic_alltasks]
if (p_finduid(uid) = false) {
    return;
}
%relic_tasks_done = or(or(^relic_tier1_mask, ^relic_tier2_mask), ^relic_tier3_mask);
~relic_say("tasks 1-23 done, mask <tostring(%relic_tasks_done)>");
