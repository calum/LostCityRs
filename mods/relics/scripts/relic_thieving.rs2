// 30 Light Fingers and the thieving tasks. Hook lines are in Content skill_thieving/scripts/thieving.rs2 (grep "relic hook");
// the list of hooks is in docs/local-changes.md, the design in docs/design/relics-light-fingers.md.

// check_if_success_pick_pocket: a Light Fingers owner never fails a pickpocket (no stun, no damage).
[proc,relic_pickpocket_sure]()(boolean)
if (~relic_has(30) = 1) {
    return(true);
}
return(false);

// pick_pocket, after a successful pick: Light Fingers picks the same pocket again. Two ticks of %action_delay make the next
// attempt wait in attempt_pick_pocket's own "p_opnpc(3)" wait loop, where the player is not delayed. A pick itself ends in
// p_delay, and a walk click that arrives while the player is delayed is dropped (MoveClickHandler), so without this gap the
// loop could not be cancelled. A walk or any other click clears the interaction in one of the waiting ticks.
[proc,relic_pickpocket_again]
if (~relic_has(30) = 1) {
    %action_delay = calc(map_clock + 2);
    p_opnpc(3);
}

// steal_from_stall, after the delay: true for a Light Fingers owner, whose stalls never empty (the caller pays the reward and
// repeats the op instead of swapping the stall for the empty market table).
[proc,relic_stall_keeps]()(boolean)
if (~relic_has(30) = 1) {
    return(true);
}
return(false);

// steal_from_stall, Light Fingers repeat: same gap as ~relic_pickpocket_again (two ticks of waiting where the player is not delayed,
// so a walk click can clear the interaction). ~relic_stall_wait, at the top of attempt_steal_from_stall, does the waiting.
[proc,relic_stall_again]
%action_delay = calc(map_clock + 2);
p_oploc(2);

[proc,relic_stall_wait]()(boolean)
if (~relic_has(30) = 1 & %action_delay > map_clock) {
    p_oploc(2);
    return(true);
}
return(false);

// steal_from_stall, after a theft. Task 41 (tier 3): steal from a gem stall.
[proc,relic_task_steal]
if (loc_type = gem_stall_stealing) {
    ~relic_task_try(41, 3);
}
