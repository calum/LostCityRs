// Gathering and task-product hooks (docs/local-changes.md). Relics: 10 Eternal Vein, 11 Evergreen, 12 Double Yield.

// Replaces inv_add(inv, $obj, 1) at gathering and cooking sites. $relic is the skill relic (10 mining, 11 woodcutting, 0 none):
// with it the product goes straight to the bank (falls back to the inventory if the bank cannot take it).
// Double Yield (12) doubles the count when it fits. Also counts the product for tasks.
// Returns how many were produced (1 or 2): the mining, fishing and cooking sites multiply the skill's XP by it.
// With Eternal Vein (10) a mined ore is smelted on the spot: the bar replaces the ore and its smithing XP is granted per bar.
[proc,relic_gathered](namedobj $obj, int $relic)(int)
~relic_task_obj($obj);
def_int $n = 1;
if (~relic_has(12) = 1) {
    $n = 2;
}
def_namedobj $bar = null;
if ($relic = 10 & ~relic_has(10) = 1) {
    $bar = ~relic_smelt_ore($obj);
}
if ($bar ! null) {
    $obj = $bar;
    // the bar counts for product tasks too (task 11, silver bar): the ore never reaches the inventory to be smelted by hand
    ~relic_task_obj($bar);
    // XP is the normal smelting XP of the bar (smelting.struct productexp), once per bar. No level or coal needed.
    stat_advance(smithing, multiply(struct_param(oc_param($bar, smelting_struct), productexp), $n));
    // 26 Forge Echo rolls once per bar made
    def_int $echo = 0;
    while ($echo < $n) {
        ~relic_forge_echo($bar, 1, struct_param(oc_param($bar, smelting_struct), productexp));
        $echo = calc($echo + 1);
    }
}
// to the bank when the skill relic sends it there and the bank can take it (2, else 1 with Double Yield)
if ($relic > 0 & ~relic_has($relic) = 1) {
    if ($n = 2 & inv_itemspace(bank, $obj, 2, inv_size(bank)) = ^false) {
        $n = 1;
    }
    if (inv_itemspace(bank, $obj, $n, inv_size(bank)) = ^true) {
        inv_add(bank, $obj, $n);
        return($n);
    }
}
if ($n = 2 & inv_itemspace(inv, $obj, 2, inv_size(inv)) = ^false) {
    $n = 1;
}
inv_add(inv, $obj, $n);
return($n);

// fishing.rs2 hook, replaces ~relic_gathered at the four catch sites. Returns how many fish were caught (the site multiplies fishing XP by it).
// 27 Endless Shoal: the fish arrive already cooked (never burnt), each with the normal cooking XP of that fish, no cooking level needed
// (moved here from Double Yield, Calum 2026-10-12). Double Yield only doubles the count.
// The raw fish is still counted for tasks first (task 9 asks for a raw swordfish). A fish with no cooking row stays raw.
[proc,relic_fished](namedobj $fish)(int)
if (~relic_has(27) = 1 & $fish ! tbwt_raw_karambwan) {
    db_find(cooking_generic:uncooked, $fish);
    def_dbrow $data = db_findnext;
    if ($data ! null) {
        ~relic_task_obj($fish);
        def_int $n = ~relic_gathered(db_getfield($data, cooking_generic:cooked, 0), 27);
        stat_advance(cooking, multiply(db_getfield($data, cooking_generic:experience, 0), $n));
        return($n);
    }
}
return(~relic_gathered($fish, 27));

// Ore to bar for Eternal Vein. Iron gives steel; coal, clay, gems and other rock products return null (banked unchanged).
[proc,relic_smelt_ore](namedobj $ore)(namedobj)
switch_obj ($ore) {
    case copper_ore, tin_ore : return(bronze_bar);
    case iron_ore : return(steel_bar);
    case silver_ore : return(silver_bar);
    case gold_ore : return(gold_bar);
    case perfect_gold_ore : return(perfect_gold_bar);
    case mithril_ore : return(mithril_bar);
    case adamantite_ore : return(adamantite_bar);
    case runite_ore : return(runite_bar);
    case default : return(null);
}

// mining.rs2 hooks. 10 Eternal Vein: rocks never deplete.
[proc,relic_loc_change](loc $new_loc, int $duration)
if (~relic_has(10) = 1) {
    return;
}
loc_change($new_loc, $duration);

// firemaking.rs2 hook. Task 7 (tier 2): burn a yew log. Not table driven because yew chopping (task 20) uses the same object.
[proc,relic_task_burn](obj $log)
if ($log = yew_logs) {
    ~relic_task_try(7, 2);
}

// thieving.rs2 hook (after a successful pickpocket). Task 13 (tier 2): pickpocket a paladin. Task 42 (tier 2): pickpocket a guard.
[proc,relic_task_pickpocket]
if (npc_type = paladin) {
    ~relic_task_try(13, 2);
} else if (npc_type = guard1 | npc_type = guard2 | npc_type = ardougne_guard) {
    ~relic_task_try(42, 2);
}

// mining.rs2 hook, after an ore is mined. Eternal Vein never depletes the rock (~relic_loc_change), so the swing loop goes on
// instead of ending after each ore (the rock would otherwise have depleted and ended it). Docs: docs/design/levelup-nonblocking.md.
[proc,relic_mine_again]
if (~relic_has(10) = 1) {
    p_oploc(3);
}
